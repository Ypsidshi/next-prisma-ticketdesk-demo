# Локально: после `docker compose up -d`
DATABASE_URL="postgresql://ticketdesk:ticketdesk@localhost:5432/ticketdesk?schema=public"

# Минимум 32 символа в проде; для демо достаточно длинной строки
JWT_SECRET="change-me-use-openssl-rand-base64-32-or-similar-min-32-chars"

# URL приложения (для редиректов при необходимости)
NEXT_PUBLIC_APP_NAME="Ticketdesk demo"
